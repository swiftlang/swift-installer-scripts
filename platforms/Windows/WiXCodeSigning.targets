<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SignOutput Condition=" '$(SignOutput)' == '' ">false</SignOutput>
    <SignOutput>$(SignOutput)</SignOutput>
    <SignToolVerbose Condition=" '$(SignToolVerbose)' == '' ">false</SignToolVerbose>
  </PropertyGroup>

  <Target Name="FindWindowsSDK">
    <PropertyGroup>
      <WindowsKitsRoot Condition=" '$(WindowsKitsRoot)' == '' ">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots', 'KitsRoot10', null, RegistryView.Registry32, RegistryView.Default))</WindowsKitsRoot>
      <WindowsKitsRoot Condition=" '$(WindowsKitsRoot)' == '' ">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots', 'KitsRoot81', null, RegistryView.Registry32, RegistryView.Default))</WindowsKitsRoot>
      <WindowsKitsRoot Condition=" '$(WindowsKitsRoot)' == '' ">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots', 'KitsRoot', null, RegistryView.Registry32, RegistryView.Default))</WindowsKitsRoot>
      <WindowsSDKToolArchitecture Condition=" '$(WindowsSDKToolArchitecture)' == '' AND '$(PROCESSOR_ARCHITECTURE)' == 'ARM64' ">arm64</WindowsSDKToolArchitecture>
      <WindowsSDKToolArchitecture Condition=" '$(WindowsSDKToolArchitecture)' == '' ">x64</WindowsSDKToolArchitecture>
      <WindowsSDKToolsPath Condition=" '$(WindowsSDKToolsPath)' != '' AND !HasTrailingSlash('$(WindowsSDKToolsPath)') ">$(WindowsSDKToolsPath)\</WindowsSDKToolsPath>
    </PropertyGroup>

    <ItemGroup Condition=" '$(WindowsSDKToolsPath)' == '' ">
      <_WindowsSDKToolVersion Include="10.0.26100.0" />
      <_WindowsSDKToolVersion Include="10.0.25398.0" />
      <_WindowsSDKToolVersion Include="10.0.22621.0" />
      <_WindowsSDKToolVersion Include="10.0.22000.0" />
      <_WindowsSDKToolVersion Include="10.0.20348.0" />
      <_WindowsSDKToolVersion Include="10.0.19041.0" />
      <_WindowsSDKToolVersion Include="10.0.18362.0" />
      <_WindowsSDKToolVersion Include="10.0.17763.0" />
      <_WindowsSDKToolVersion Include="10.0.17134.0" />
      <_WindowsSDKToolVersion Include="10.0.16299.0" />
      <_WindowsSDKToolVersion Include="10.0.15063.0" />
      <_WindowsSDKToolVersion Include="10.0.14393.0" />
      <_WindowsSDKToolVersion Include="10.0.10586.0" />
      <_WindowsSDKToolVersion Include="10.0.10240.0" />
      <_WindowsSDKToolCandidateFile
          Include="$(WindowsKitsRoot)bin\*\$(WindowsSDKToolArchitecture)\mt.exe"
          Condition=" '$(WindowsKitsRoot)' != '' " />
      <_WindowsSDKToolCandidate
          Include="@(_WindowsSDKToolVersion->'$(WindowsKitsRoot)bin\%(Identity)\$(WindowsSDKToolArchitecture)\')"
          Condition=" '$(WindowsKitsRoot)' != '' " />
      <_WindowsSDKToolCandidate
          Include="@(_WindowsSDKToolCandidateFile->'%(RootDir)%(Directory)')" />
      <_WindowsSDKToolCandidate
          Remove="@(_WindowsSDKToolCandidate)"
          Condition="!Exists('%(_WindowsSDKToolCandidate.Identity)')" />
    </ItemGroup>

    <PropertyGroup>
      <_WindowsSDKToolCandidates>@(_WindowsSDKToolCandidate, ';')</_WindowsSDKToolCandidates>
      <WindowsSDKToolsPath
          Condition=" '$(WindowsSDKToolsPath)' == '' AND '$(_WindowsSDKToolCandidates)' != '' ">$([System.String]::Copy('$(_WindowsSDKToolCandidates)').Split(';').GetValue(0))</WindowsSDKToolsPath>
      <WindowsSDKToolsPath
          Condition=" '$(WindowsSDKToolsPath)' == '' AND '$(WindowsKitsRoot)' != '' AND Exists('$(WindowsKitsRoot)bin\$(WindowsSDKToolArchitecture)\')">$(WindowsKitsRoot)bin\$(WindowsSDKToolArchitecture)\</WindowsSDKToolsPath>
    </PropertyGroup>
  </Target>

  <Target Name="FindSignTool" DependsOnTargets="FindWindowsSDK">
    <PropertyGroup>
      <SignToolPath Condition=" '$(SignToolPath)' == '' ">$(WindowsSDKToolsPath)</SignToolPath>
      <SignToolPath Condition=" '$(SignToolPath)' != '' AND !HasTrailingSlash('$(SignToolPath)') ">$(SignToolPath)\</SignToolPath>

      <_SigningMode Condition=" '$(AzureSignToolPath)' != '' ">AzureKeyVault</_SigningMode>
      <_SigningMode Condition=" '$(_SigningMode)' == '' AND '$(AzureSignMetadata)' != '' ">TrustedSigning</_SigningMode>
      <_SigningMode Condition=" '$(_SigningMode)' == '' ">Pfx</_SigningMode>

      <_SigningExecutable Condition=" '$(_SigningMode)' == 'AzureKeyVault' ">$(AzureSignToolPath)</_SigningExecutable>
      <_SigningExecutable Condition=" '$(_SigningMode)' != 'AzureKeyVault' ">$(SignToolPath)signtool.exe</_SigningExecutable>

      <_SigningVerboseArgument Condition=" '$(SignToolVerbose)' == 'true' AND '$(_SigningMode)' == 'AzureKeyVault' "> --verbose</_SigningVerboseArgument>
      <_SigningVerboseArgument Condition=" '$(SignToolVerbose)' == 'true' AND '$(_SigningMode)' != 'AzureKeyVault' "> /v</_SigningVerboseArgument>

      <!-- Microsoft recommends using their timestamp server for trusted signing: https://learn.microsoft.com/en-us/azure/trusted-signing/how-to-signing-integrations#:~:text=Trusted%20Signing%20certificates,microsoft.com/-->
      <_SigningTimestampUrl Condition=" '$(_SigningMode)' == 'TrustedSigning' ">http://timestamp.acs.microsoft.com</_SigningTimestampUrl>
      <_SigningTimestampUrl Condition=" '$(_SigningMode)' != 'TrustedSigning' ">http://timestamp.digicert.com</_SigningTimestampUrl>

      <!-- AzureSignTool implements its managed identity option with DefaultAzureCredential, which includes an existing Azure CLI session. -->
      <SignTool Condition=" '$(_SigningMode)' == 'AzureKeyVault' ">"$(_SigningExecutable)" sign$(_SigningVerboseArgument) --azure-key-vault-url "%AZURE_KEY_VAULT_URI%" --azure-key-vault-managed-identity --azure-key-vault-certificate "%AZURE_KEY_VAULT_CERTIFICATE_NAME%" --file-digest sha256 --timestamp-rfc3161 "$(_SigningTimestampUrl)" --timestamp-digest sha256</SignTool>
      <SignTool Condition=" '$(_SigningMode)' == 'TrustedSigning' ">"$(_SigningExecutable)" sign$(_SigningVerboseArgument) /tr $(_SigningTimestampUrl) /fd sha256 /td sha256 /dlib "$(AzureSignDlib)" /dmdf "$(AzureSignMetadata)"</SignTool>
      <SignTool Condition=" '$(_SigningMode)' == 'Pfx' ">"$(_SigningExecutable)" sign$(_SigningVerboseArgument) /tr $(_SigningTimestampUrl) /fd sha256 /td sha256 /f "$(CERTIFICATE)" /p "$(PASSPHRASE)"</SignTool>
    </PropertyGroup>

    <ItemGroup Condition=" '$(_SigningMode)' == 'AzureKeyVault' ">
      <_MissingAzureSigningEnvironmentVariable Include="AZURE_KEY_VAULT_URI" Condition=" '$(AZURE_KEY_VAULT_URI)' == '' " />
      <_MissingAzureSigningEnvironmentVariable Include="AZURE_KEY_VAULT_CERTIFICATE_NAME" Condition=" '$(AZURE_KEY_VAULT_CERTIFICATE_NAME)' == '' " />
    </ItemGroup>

    <Error Condition=" '$(_SigningMode)' == 'AzureKeyVault' AND !Exists('$(_SigningExecutable)') "
           Text="Unable to locate AzureSignTool. Set AzureSignToolPath to the AzureSignTool executable." />
    <Error Condition=" '@(_MissingAzureSigningEnvironmentVariable)' != '' "
           Text="Azure Key Vault signing requires the following environment variables: @(_MissingAzureSigningEnvironmentVariable, ', ')." />
    <Error Condition=" '$(_SigningMode)' != 'AzureKeyVault' AND ('$(SignToolPath)' == '' OR !Exists('$(_SigningExecutable)')) "
           Text="Unable to locate signtool.exe. Set SignToolPath to the Windows SDK bin directory." />
  </Target>

  <Target Name="FindWindowsSDKTools" DependsOnTargets="FindWindowsSDK">
    <PropertyGroup>
      <ManifestToolPath Condition=" '$(ManifestToolPath)' == '' ">$(WindowsSDKToolsPath)</ManifestToolPath>
      <MakeCatToolPath Condition=" '$(MakeCatToolPath)' == '' ">$(WindowsSDKToolsPath)</MakeCatToolPath>
      <ManifestToolPath Condition=" '$(ManifestToolPath)' != '' AND !HasTrailingSlash('$(ManifestToolPath)') ">$(ManifestToolPath)\</ManifestToolPath>
      <MakeCatToolPath Condition=" '$(MakeCatToolPath)' != '' AND !HasTrailingSlash('$(MakeCatToolPath)') ">$(MakeCatToolPath)\</MakeCatToolPath>
    </PropertyGroup>

    <Error Condition=" '$(ManifestToolPath)' == '' OR !Exists('$(ManifestToolPath)mt.exe') "
           Text="Unable to locate mt.exe. Set ManifestToolPath to the Windows SDK bin directory." />
    <Error Condition=" '$(MakeCatToolPath)' == '' OR !Exists('$(MakeCatToolPath)makecat.exe') "
           Text="Unable to locate makecat.exe. Set MakeCatToolPath to the Windows SDK bin directory." />
  </Target>

  <Target Name="SignCabs" DependsOnTargets="FindSignTool">
    <Exec Command="$(SignTool) &quot;%(SignCabs.FullPath)&quot;" />
  </Target>

  <Target Name="SignMsi" DependsOnTargets="FindSignTool">
    <Exec Command="$(SignTool) &quot;%(SignMsi.FullPath)&quot;" />
  </Target>

  <Target Name="SignMsm" DependsOnTargets="FindSignTool">
    <Exec Command="$(SignTool) &quot;%(SignMsm.FullPath)&quot;" />
  </Target>

  <Target Name="SignBundleEngine" DependsOnTargets="FindSignTool">
    <Exec Command="$(SignTool) &quot;@(SignBundleEngine)&quot;" />
  </Target>

  <Target Name="SignBundle" DependsOnTargets="FindSignTool">
    <Exec Command="$(SignTool) &quot;@(SignBundle)&quot;" />
  </Target>
</Project>
